# Environment Variables для Бесплатного Деплоя
# Используйте этот шаблон для Vercel + Supabase/Railway/Render

# ===========================================
# БАЗА ДАННЫХ (выберите один вариант)
# ===========================================

# Вариант 1: Supabase (рекомендуется)
# Получить в: Supabase Dashboard → Settings → Database → Connection string → URI
# DB_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@db.xxx.supabase.co:5432/postgres

# Вариант 2: Railway
# Скопировать из: Railway Dashboard → PostgreSQL → Variables → DATABASE_URL
# DB_URL=postgresql://postgres:xxx@xxx.railway.internal:5432/railway

# Вариант 3: Render
# Скопировать из: Render Dashboard → PostgreSQL → Internal Database URL
# DB_URL=postgres://cars:xxx@xxx.frankfurt-postgres.render.com/cars

# Для всех вариантов:
DB_SCHEMA=public

# ===========================================
# JWT SECRETS (обязательно изменить!)
# ===========================================
# Сгенерируйте уникальные секреты:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_ACCESS_SECRET=ЗАМЕНИТЕ-НА-СЛУЧАЙНУЮ-СТРОКУ-32-СИМВОЛА-МИНИМУМ
JWT_REFRESH_SECRET=ЗАМЕНИТЕ-НА-ДРУГУЮ-СЛУЧАЙНУЮ-СТРОКУ-32-СИМВОЛА
JWT_WEBSOCKET_SECRET=ЗАМЕНИТЕ-НА-ЕЩЕ-ОДНУ-СЛУЧАЙНУЮ-СТРОКУ-32-СИМВОЛА
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=30d
JWT_WEBSOCKET_EXPIRES_IN=24h

# ===========================================
# АДМИН ПАНЕЛЬ (обязательно изменить пароль!)
# ===========================================

ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=ИЗМЕНИТЕ-ЭТОТ-ПАРОЛЬ-НА-СИЛЬНЫЙ
# Сгенерируйте случайные строки (32+ символов):
ADMIN_SESSION_SECRET=ЗАМЕНИТЕ-НА-СЛУЧАЙНУЮ-СТРОКУ-ДЛЯ-СЕССИЙ
ADMIN_COOKIE_PASSWORD=ЗАМЕНИТЕ-НА-СЛУЧАЙНУЮ-СТРОКУ-ДЛЯ-КУКИ
ADMIN_COOKIE_NAME=adminjs
ADMIN_PANEL_PATH=/admin

# ===========================================
# ПРИЛОЖЕНИЕ
# ===========================================

PORT=3000
NODE_ENV=production

# ===========================================
# SMS (необязательно - для тестирования)
# ===========================================

SMS_TEST_MODE=true
# SMS_RU_API_ID=ваш-ключ-sms-ru (если нужны реальные СМС)

# ===========================================
# S3 STORAGE (необязательно)
# ===========================================

# Если нужно загружать файлы, используйте бесплатный Cloudflare R2:
# https://dash.cloudflare.com/
# S3_ACCESS_KEY=ваш-access-key
# S3_SECRET_KEY=ваш-secret-key
# S3_BUCKET_NAME=cars-uploads
# S3_API_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_REGION=auto

# ===========================================
# CLOUDINARY (альтернатива S3, бесплатно 25GB)
# ===========================================

# Получить на: https://cloudinary.com (бесплатно)
# CLOUDINARY_CLOUD_NAME=ваше-имя
# CLOUDINARY_API_KEY=ваш-api-key
# CLOUDINARY_API_SECRET=ваш-api-secret

# ===========================================
# ИНСТРУКЦИИ ПО ГЕНЕРАЦИИ СЕКРЕТОВ
# ===========================================
#
# В терминале выполните:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Скопируйте результат и вставьте в переменные выше
# Повторите для каждого секрета (нужно 5 разных строк)
#
# ===========================================
