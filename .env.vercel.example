# Vercel Environment Variables Template
# Copy these to Vercel Dashboard → Settings → Environment Variables

# ===========================================
# DATABASE (REQUIRED)
# ===========================================
# Get this from Vercel Postgres, Supabase, or Railway
DB_URL=postgres://username:password@host:5432/database
DB_SCHEMA=cars

# ===========================================
# JWT SECRETS (REQUIRED)
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_WEBSOCKET_SECRET=your-super-secret-websocket-key-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=30d
JWT_WEBSOCKET_EXPIRES_IN=24h

# ===========================================
# ADMIN PANEL (REQUIRED)
# ===========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123Change!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=your-very-long-session-secret-minimum-32-characters
ADMIN_COOKIE_PASSWORD=your-very-long-cookie-secret-minimum-32-characters
ADMIN_COOKIE_NAME=adminjs
ADMIN_PANEL_PATH=/admin

# ===========================================
# APPLICATION (REQUIRED)
# ===========================================
PORT=3000
NODE_ENV=production

# ===========================================
# SMS (OPTIONAL)
# ===========================================
SMS_RU_API_ID=your-sms-ru-api-key
SMS_TEST_MODE=true

# ===========================================
# S3 STORAGE (OPTIONAL - for file uploads)
# ===========================================
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=cars-bucket
S3_API_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1

# ===========================================
# SSL (NOT NEEDED ON VERCEL - automatic HTTPS)
# ===========================================
# SSL_KEY_PATH=/not/needed/on/vercel
# SSL_CERT_PATH=/not/needed/on/vercel

# ===========================================
# CLOUDINARY (OPTIONAL - alternative to S3)
# ===========================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
