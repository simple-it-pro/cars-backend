E1_2[CarExpensesService.getAll]
E1_3[Check ownership via GarageService]
E1_4[CarExpenseRepository.find<br/>where car.id = carId<br/>order by date createdAt]
E1_5[Return expenses list and total]

E1_0 --> E1_1 --> E1_2 --> E1_3 --> E1_4 --> E1_5
end

%% --- E2: Get single expense ---
subgraph E2[Get expense by id]
direction TB
E2_0[Client<br/>GET /garage/cars/:carId/expenses/:expenseId]
E2_1[CarExpensesController.getOne]
E2_2[CarExpensesService.getOne]
E2_3[Check ownership]
E2_4[CarExpenseRepository.findOne<br/>by id and car.id]
E2_5{Expense found?}
E2_X1[NotFound<br/>GARAGE.EXPENSE.NOT_FOUND]
E2_6[Return expense entity]

E2_0 --> E2_1 --> E2_2 --> E2_3 --> E2_4 --> E2_5
E2_5 -- no --> E2_X1
E2_5 -- yes --> E2_6
end

%% --- E3: Create expense ---
subgraph E3[Create expense]
direction TB
E3_0[Client<br/>POST /garage/cars/:carId/expenses]
E3_1[CarExpensesController.create]
E3_2[CarExpensesService.create]
E3_3[Check ownership via GarageService]
E3_4[Set date from dto or now]
E3_5[CarExpenseRepository.create<br/>with car relation]
E3_6[CarExpenseRepository.save]
E3_7[Return message and expense]

E3_0 --> E3_1 --> E3_2 --> E3_3 --> E3_4 --> E3_5 --> E3_6 --> E3_7
end

%% --- E4: Update expense ---
subgraph E4[Update expense]
direction TB
E4_0[Client<br/>PATCH /garage/cars/:carId/expenses/:expenseId]
E4_1[CarExpensesController.update]
E4_2[CarExpensesService.update]
E4_3[Check ownership]
E4_4[findOne by id and car.id]
E4_5{Expense found?}
E4_X1[NotFound<br/>GARAGE.EXPENSE.NOT_FOUND]
E4_6[Merge dto into entity]
E4_7[Save updated expense]
E4_8[Return message and expense]

E4_0 --> E4_1 --> E4_2 --> E4_3 --> E4_4 --> E4_5
E4_5 -- no --> E4_X1
E4_5 -- yes --> E4_6 --> E4_7 --> E4_8
end

%% --- E5: Delete expense ---
subgraph E5[Delete expense]
direction TB
E5_0[Client<br/>DELETE /garage/cars/:carId/expenses/:expenseId]
E5_1[CarExpensesController.delete]
E5_2[CarExpensesService.delete]
E5_3[Check ownership]
E5_4[Delete by id and car.id]
E5_5{Rows affected > 0?}
E5_X1[NotFound<br/>GARAGE.EXPENSE.NOT_FOUND]
E5_6[Return message only]

E5_0 --> E5_1 --> E5_2 --> E5_3 --> E5_4 --> E5_5
E5_5 -- no --> E5_X1
E5_5 -- yes --> E5_6
end
end

