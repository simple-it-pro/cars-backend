flowchart TB

%% =========================
%% ARCHITECTURE OVERVIEW
%% =========================
    subgraph ARCH[Architecture overview — Garage module]
direction LR

subgraph API[HTTP API — Controllers]
G_API[GarageController\n/garage/cars]
E_API[CarExpensesController\n/garage/cars/:carId/expenses]
S_API[ServiceRecordsController\n/garage/cars/:carId/service-records]
end

subgraph SVCS[Application services]
G_S[GarageService]
E_S[CarExpensesService]
S_S[ServiceRecordsService]
end

subgraph REPOS[TypeORM repositories]
RCar[CarRepository]
RPhoto[CarPhotoRepository]
RFile[FileRepository]
RExp[CarExpenseRepository]
RRec[ServiceRecordRepository]
end

subgraph DB[PostgreSQL tables]
TCar[[cars]]
TPhoto[[car_photos]]
TFile[[files]]
TExp[[car_expenses]]
TRec[[car_service_records]]
end

%% Controllers -> Services
G_API --> G_S
E_API --> E_S
S_API --> S_S

%% Cross-service dependency
E_S --- G_S
S_S --- G_S

%% Services -> Repositories
G_S --- RCar
G_S --- RPhoto
G_S --- RFile

E_S --- RExp

S_S --- RRec

%% Repositories -> DB tables
RCar --> TCar
RPhoto --> TPhoto
RFile --> TFile
RExp --> TExp
RRec --> TRec
end

%% =========================
%% FLOWS — CARS
%% =========================
    subgraph FLOWS[Key flows — Garage]
direction TB

%% -------- F1: Create car --------
    subgraph F1[Create car]
direction TB
F1_0[Client\nPOST /garage/cars]
F1_1[GarageController.create]
F1_2[GarageService.create]
F1_3[Set owner by userId\nstatus = WAREHOUSE]
F1_4[CarRepository.create]
F1_5[CarRepository.save]
F1_6[Return message and car]

F1_0 --> F1_1 --> F1_2 --> F1_3 --> F1_4 --> F1_5 --> F1_6
end

%% -------- F2: Get all cars with optional status --------
    subgraph F2[Get all cars]
direction TB
F2_0[Client\nGET /garage/cars?status]
F2_1[GarageController.getAll]
F2_2[GarageService.getAll]
F2_3[Build where by ownerId\nand optional status]
F2_4[CarRepository.find\nrelations: owner]
F2_5[Return cars list and total]

F2_0 --> F2_1 --> F2_2 --> F2_3 --> F2_4 --> F2_5
end

%% -------- F3: Get single car --------
    subgraph F3[Get car by id]
direction TB
F3_0[Client\nGET /garage/cars/:id]
F3_1[GarageController.getOne]
F3_2[GarageService.getOne]
F3_3[CarRepository.findOne\nwhere id and ownerId]
F3_4{Car found?}
F3_X1[NotFound\nGARAGE.CAR.NOT_FOUND]
F3_5[Return car entity]

F3_0 --> F3_1 --> F3_2 --> F3_3 --> F3_4
F3_4 -- no --> F3_X1
F3_4 -- yes --> F3_5
end

%% -------- F4: Update car --------
    subgraph F4[Update car]
direction TB
F4_0[Client\nPATCH /garage/cars/:id]
F4_1[GarageController.update]
F4_2[GarageService.update]
F4_3[GarageService.getOne\ncheck ownership]
F4_4{Car status = LISTED?}
F4_5[validateCarForSale\nprevent removing required fields]
F4_6[CarRepository.update]
F4_7[GarageService.getOne\nload updated car]
F4_8[Return message and car]

F4_0 --> F4_1 --> F4_2 --> F4_3 --> F4_4
F4_4 -- yes --> F4_5 --> F4_6
F4_4 -- no --> F4_6
F4_6 --> F4_7 --> F4_8
end

%% -------- F5: Delete car --------
    subgraph F5[Delete car]
direction TB
F5_0[Client\nDELETE /garage/cars/:id]
F5_1[GarageController.delete]
F5_2[GarageService.delete]
F5_3[GarageService.getOne]
F5_4[CarRepository.remove]
F5_5[Return message only]

F5_0 --> F5_1 --> F5_2 --> F5_3 --> F5_4 --> F5_5
end

%% -------- F6: Change car status --------
    subgraph F6[Change car status]
direction TB
F6_0[Client\nPATCH /garage/cars/:id/status]
F6_1[GarageController.changeStatus]
F6_2[GarageService.changeStatus]
F6_3[GarageService.getOne]
F6_4[Build updateData with new status]
F6_5{Status = LISTED?}
F6_X1[BadRequest\nPRICE_REQUIRED]
F6_6[validateCarForPublication\ncheck required fields]
F6_7[Set price from body]
F6_8[For ARCHIVED or WAREHOUSE\nreset price to null]
F6_9[CarRepository.update]
F6_10[GarageService.getOne]
F6_11[Return message and car]

F6_0 --> F6_1 --> F6_2 --> F6_3 --> F6_4 --> F6_5
F6_5 -- yes --> F6_6 --> F6_7 --> F6_9
F6_5 -- no --> F6_8 --> F6_9
F6_9 --> F6_10 --> F6_11

F6_6 -. may throw .-> F6_X1
end

%% -------- F7: Add car photos --------
    subgraph F7[Add car photos]
direction TB
F7_0[Client\nPOST /garage/cars/:id/photos\nmultipart photos]
F7_1[GarageController.addPhotos\nFilesInterceptor]
F7_2[GarageService.addPhotos]
F7_3[GarageService.getOne\nwith photos]
F7_4{Photos array empty?}
F7_X1[BadRequest\nNO_PHOTOS]
F7_5{Total photos > 10?}
F7_X2[BadRequest\nTOO_MANY_PHOTOS]
F7_6[Loop files\nvalidate mimetype image/*]
        F7_7[FileRepository.create and save]
        F7_8[CarPhotoRepository.create and save\nwith order]
        F7_9[Reload car with photos]
        F7_10[Return message and car]

        F7_0 --> F7_1 --> F7_2 --> F7_3 --> F7_4
        F7_4 -- yes --> F7_X1
        F7_4 -- no --> F7_5
        F7_5 -- yes --> F7_X2
        F7_5 -- no --> F7_6 --> F7_7 --> F7_8 --> F7_9 --> F7_10
    end

    %% -------- F8: Remove car photo --------
    subgraph F8[Remove car photo]
    direction TB
        F8_0[Client\nDELETE /garage/cars/:id/photos/:photoId]
        F8_1[GarageController.removePhoto]
        F8_2[GarageService.removePhoto]
        F8_3[GarageService.getOne\nwith photos]
        F8_4[Find photo in car.photos by id]
        F8_5{Photo exists?}
        F8_X1[NotFound\nPHOTO_NOT_FOUND]
        F8_6[CarPhotoRepository.delete]
        F8_7[FileRepository.delete]
        F8_8[Reload photos\nsorted by order]
        F8_9[Normalize order indices]
        F8_10[CarPhotoRepository.save]
        F8_11[Reload car]
        F8_12[Return message and car]

        F8_0 --> F8_1 --> F8_2 --> F8_3 --> F8_4 --> F8_5
        F8_5 -- no --> F8_X1
        F8_5 -- yes --> F8_6 --> F8_7 --> F8_8 --> F8_9 --> F8_10 --> F8_11 --> F8_12
    end

    %% -------- F9: Reorder car photos --------
    subgraph F9[Reorder car photos]
    direction TB
        F9_0[Client\nPATCH /garage/cars/:id/photos/reorder]
        F9_1[GarageController.reorderPhotos]
        F9_2[GarageService.reorderPhotos]
        F9_3[GarageService.getOne\nwith photos]
        F9_4{photoIds length == photos length?}
        F9_X1[BadRequest\nPHOTO_IDS_COUNT_MISMATCH]
        F9_5[Check each id belongs to car]
        F9_X2[BadRequest\nPHOTO_NOT_BELONGS_TO_CAR]
        F9_6[Build new order map]
        F9_7[Update CarPhoto.order\nfor each id]
        F9_8[Reload car]
        F9_9[Return message and car]

        F9_0 --> F9_1 --> F9_2 --> F9_3 --> F9_4
        F9_4 -- no --> F9_X1
        F9_4 -- yes --> F9_5
        F9_5 -- invalid id --> F9_X2
        F9_5 -- ok --> F9_6 --> F9_7 --> F9_8 --> F9_9
    end

    %% =========================
    %% FLOWS — EXPENSES
    %% =========================
    subgraph E_FLOWS[Car expenses]
    direction TB

        %% Helper: ownership check
        E0[GarageService.getUserCarAndCheckOwnership\nshared helper]

        %% --- E1: Get all expenses ---
        subgraph E1[Get all expenses]
        direction TB
            E1_0[Client\nGET /garage/cars/:carId/expenses]
            E1_1[CarExpensesController.getAll]
            E1_2[CarExpensesService.getAll]
            E1_3[Check ownership via GarageService]
            E1_4[CarExpenseRepository.find\nwhere car.id = carId\norder by date, createdAt]
            E1_5[Return expenses list and total]

            E1_0 --> E1_1 --> E1_2 --> E1_3 --> E1_4 --> E1_5
        end

        %% --- E2: Get single expense ---
        subgraph E2[Get expense by id]
        direction TB
            E2_0[Client\nGET /garage/cars/:carId/expenses/:expenseId]
            E2_1[CarExpensesController.getOne]
            E2_2[CarExpensesService.getOne]
            E2_3[Check ownership]
            E2_4[CarExpenseRepository.findOne\nby id and car.id]
            E2_5{Expense found?}
            E2_X1[NotFound\nGARAGE.EXPENSE.NOT_FOUND]
            E2_6[Return expense entity]

            E2_0 --> E2_1 --> E2_2 --> E2_3 --> E2_4 --> E2_5
            E2_5 -- no --> E2_X1
            E2_5 -- yes --> E2_6
        end

        %% --- E3: Create expense ---
        subgraph E3[Create expense]
        direction TB
            E3_0[Client\nPOST /garage/cars/:carId/expenses]
            E3_1[CarExpensesController.create]
            E3_2[CarExpensesService.create]
            E3_3[Check ownership via GarageService]
            E3_4[Set date from dto or now]
            E3_5[CarExpenseRepository.create\nwith car relation]
            E3_6[CarExpenseRepository.save]
            E3_7[Return message and expense]

            E3_0 --> E3_1 --> E3_2 --> E3_3 --> E3_4 --> E3_5 --> E3_6 --> E3_7
        end

        %% --- E4: Update expense ---
        subgraph E4[Update expense]
        direction TB
            E4_0[Client\nPATCH /garage/cars/:carId/expenses/:expenseId]
            E4_1[CarExpensesController.update]
            E4_2[CarExpensesService.update]
            E4_3[Check ownership]
            E4_4[findOne by id and car.id]
            E4_5{Expense found?}
            E4_X1[NotFound\nGARAGE.EXPENSE.NOT_FOUND]
            E4_6[Merge dto into entity]
            E4_7[Save updated expense]
            E4_8[Return message and expense]

            E4_0 --> E4_1 --> E4_2 --> E4_3 --> E4_4 --> E4_5
            E4_5 -- no --> E4_X1
            E4_5 -- yes --> E4_6 --> E4_7 --> E4_8
        end

        %% --- E5: Delete expense ---
        subgraph E5[Delete expense]
        direction TB
            E5_0[Client\nDELETE /garage/cars/:carId/expenses/:expenseId]
            E5_1[CarExpensesController.delete]
            E5_2[CarExpensesService.delete]
            E5_3[Check ownership]
            E5_4[findOne by id and car.id]
            E5_5{Expense found?}
            E5_X1[NotFound\nGARAGE.EXPENSE.NOT_FOUND]
            E5_6[Remove expense entity]
            E5_7[Return message only]

            E5_0 --> E5_1 --> E5_2 --> E5_3 --> E5_4 --> E5_5
            E5_5 -- no --> E5_X1
            E5_5 -- yes --> E5_6 --> E5_7
        end
    end

    %% =========================
    %% FLOWS — SERVICE RECORDS
    %% =========================
    subgraph SR_FLOWS[Service records]
    direction TB

        %% --- SR1: Get all service records ---
        subgraph SR1[Get all service records]
        direction TB
            SR1_0[Client\nGET /garage/cars/:carId/service-records]
            SR1_1[ServiceRecordsController.getAll]
            SR1_2[ServiceRecordsService.getAll]
            SR1_3[Check ownership via GarageService]
            SR1_4[ServiceRecordRepository.find\nwhere car.id = carId\norder by serviceDate, createdAt]
            SR1_5[Return records list and total]

            SR1_0 --> SR1_1 --> SR1_2 --> SR1_3 --> SR1_4 --> SR1_5
        end

        %% --- SR2: Get single service record ---
        subgraph SR2[Get service record by id]
        direction TB
            SR2_0[Client\nGET /garage/cars/:carId/service-records/:recordId]
            SR2_1[ServiceRecordsController.getOne]
            SR2_2[ServiceRecordsService.getOne]
            SR2_3[Check ownership]
            SR2_4[findOne by id and car.id]
            SR2_5{Record found?}
            SR2_X1[NotFound\nSERVICE_RECORD.NOT_FOUND]
            SR2_6[Return service record entity]

            SR2_0 --> SR2_1 --> SR2_2 --> SR2_3 --> SR2_4 --> SR2_5
            SR2_5 -- no --> SR2_X1
            SR2_5 -- yes --> SR2_6
        end

        %% --- SR3: Create service record ---
        subgraph SR3[Create service record]
        direction TB
            SR3_0[Client\nPOST /garage/cars/:carId/service-records]
            SR3_1[ServiceRecordsController.create]
            SR3_2[ServiceRecordsService.create]
            SR3_3[Check ownership via GarageService]
            SR3_4[ServiceRecordRepository.create\nwith car relation]
            SR3_5[ServiceRecordRepository.save]
            SR3_6[Return message and record]

            SR3_0 --> SR3_1 --> SR3_2 --> SR3_3 --> SR3_4 --> SR3_5 --> SR3_6
        end

        %% --- SR4: Update service record ---
        subgraph SR4[Update service record]
        direction TB
            SR4_0[Client\nPATCH /garage/cars/:carId/service-records/:recordId]
            SR4_1[ServiceRecordsController.update]
            SR4_2[ServiceRecordsService.update]
            SR4_3[Check ownership]
            SR4_4[findOne by id and car.id]
            SR4_5{Record found?}
            SR4_X1[NotFound\nSERVICE_RECORD.NOT_FOUND]
            SR4_6[Merge dto into entity]
            SR4_7[Save updated record]
            SR4_8[Return message and record]

            SR4_0 --> SR4_1 --> SR4_2 --> SR4_3 --> SR4_4 --> SR4_5
            SR4_5 -- no --> SR4_X1
            SR4_5 -- yes --> SR4_6 --> SR4_7 --> SR4_8
        end

        %% --- SR5: Delete service record ---
        subgraph SR5[Delete service record]
        direction TB
            SR5_0[Client\nDELETE /garage/cars/:carId/service-records/:recordId]
            SR5_1[ServiceRecordsController.delete]
            SR5_2[ServiceRecordsService.delete]
            SR5_3[Check ownership]
            SR5_4[Delete by id and car.id]
            SR5_5{Rows affected > 0?}
            SR5_X1[NotFound\nSERVICE_RECORD.NOT_FOUND]
            SR5_6[Return message only]

            SR5_0 --> SR5_1 --> SR5_2 --> SR5_3 --> SR5_4 --> SR5_5
            SR5_5 -- no --> SR5_X1
            SR5_5 -- yes --> SR5_6
        end
    end
end
