subgraph FLOWS [Key flows]
direction TB

subgraph F1 [getPublicProfile]
direction TB
F1_0[Client GET users id public]
F1_1[Service getPublicProfile]
F1_2[RatingService calculateAndUpdateUserRating]
F1_3[UserRepository findOne selected fields not deleted]
F1_4{User found}
F1_5{Deactivated}
F1_6[StorageService getFileUrl if image]
F1_7[Return Partial User with signed image url]
F1_X1[NotFound]
F1_X2[BadRequest public profile not available]

    F1_0 --> F1_1 --> F1_2 --> F1_3 --> F1_4
    F1_4 -- no --> F1_X1
    F1_4 -- yes --> F1_5
    F1_5 -- yes --> F1_X2
    F1_5 -- no --> F1_6 --> F1_7
end

subgraph F2 [updateUserById]
direction TB
F2_0[Client PATCH users id]
F2_1[findOne by id not deleted]
F2_2{User exists}
F2_X1[BadRequest user not found]
F2_3[Check unique nickname email phone]
F2_4{Conflicts}
F2_X2[BadRequest duplicate]
F2_5[Validate city via cities json]
F2_6{City exists}
F2_X3[BadRequest city not found]
F2_7[Merge and save]
F2_8[Return updated user]

    F2_0 --> F2_1 --> F2_2
    F2_2 -- no --> F2_X1
    F2_2 -- yes --> F2_3 --> F2_4
    F2_4 -- yes --> F2_X2
    F2_4 -- no --> F2_5 --> F2_6
    F2_6 -- no --> F2_X3
    F2_6 -- yes --> F2_7 --> F2_8
end

subgraph F3 [updateAvatar]
direction TB
F3_0[Client PATCH users id avatar]
F3_1[findOne by id]
F3_2{User exists}
F3_X1[BadRequest user not found]
F3_3[Delete old image best effort]
F3_4[Upload file to storage]
F3_5[Save user image url size name]
F3_6[Get signed url]
F3_7[Return user with signed url]

    F3_0 --> F3_1 --> F3_2
    F3_2 -- no --> F3_X1
    F3_2 -- yes --> F3_3 --> F3_4 --> F3_5 --> F3_6 --> F3_7
end

subgraph F4 [subscribeUser]
direction TB
F4_0[Client POST users id subscribe]
F4_1[findOne user and target]
F4_2{Both exist}
F4_X1[BadRequest user not found]
F4_3{Self subscribe}
F4_X2[BadRequest self subscribe]
F4_4[checkBlockStatus]
F4_X3[Forbidden blocked relation]
F4_5[Find existing subscription]
F4_6{Exists}
F4_X4[BadRequest already subscribed]
F4_7[Save subscription]
F4_8[Save follower]
F4_9[Notify type follow]
F4_10[Return message subscribed]

    F4_0 --> F4_1 --> F4_2
    F4_2 -- no --> F4_X1
    F4_2 -- yes --> F4_3
    F4_3 -- yes --> F4_X2
    F4_3 -- no --> F4_4
    F4_4 -- blocked --> F4_X3
    F4_4 -- ok --> F4_5 --> F4_6
    F4_6 -- yes --> F4_X4
    F4_6 -- no --> F4_7 --> F4_8 --> F4_9 --> F4_10
end

subgraph F5 [block and unblock]
direction LR

    B0[POST users id block]
    B1[findOne target]
    B2{Target exists}
    Bx1[BadRequest user not found]
    B3[findOne existing block]
    B4{Already blocked}
    Bx2[BadRequest already blocked]
    B5[save block]
    B6[Return message blocked]

    B0 --> B1 --> B2
    B2 -- no --> Bx1
    B2 -- yes --> B3 --> B4
    B4 -- yes --> Bx2
    B4 -- no --> B5 --> B6

    U0[DELETE users id block]
    U1[findOne block]
    U2{Block exists}
    Ux1[BadRequest not blocked]
    U3[remove block]
    U4[Return message unblocked]

    U0 --> U1 --> U2
    U2 -- no --> Ux1
    U2 -- yes --> U3 --> U4
end

subgraph F6 [generatePublicProfileLink]
direction TB
G0[Client GET users id public link]
G1[findOne select id and isDeactivated]
G2{User exists}
Gx1[NotFound user not found]
G3{Deactivated}
Gx2[BadRequest public profile not available]
G4[Build public url from APP_URL and id]
G5[Return public url and message]

    G0 --> G1 --> G2
    G2 -- no --> Gx1
    G2 -- yes --> G3
    G3 -- yes --> Gx2
    G3 -- no --> G4 --> G5
end
end

