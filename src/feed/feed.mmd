%% =========================
%% FLOWS — FeedService
%% =========================
subgraph FLOWS[Key flows — FeedService]
direction TB

%% -------- F1: getFeedItems --------
subgraph F1[getFeedItems]
direction TB
F1_0[Client<br/>GET /feed?cursor&take&order&type]
F1_1[FeedController.getFeed<br/>build CursorOptionsDto<br/>resolve userId and feedType]
F1_2[FeedService.getFeedItems]
F1_3[getBlockedUserIds]
F1_4[PostsService.makePostQueryBuilder<br/>includes: files, hashtags]
F1_5[Filter where status = PUBLISHED]
F1_6{blockedUserIds length > 0?}
F1_7[Exclude posts where author in blockedUserIds]
F1_8{feedType = SUBSCRIPTIONS?}
F1_9[getSubscriptionIds]
F1_10{subscriptionIds length = 0?}
F1_X1[Return empty CursorDto items <br/>meta from createCursorMeta]
F1_11[Filter posts where author in subscriptionIds]
F1_12[Apply order by createdAt then id<br/>and limit by take]
F1_13[getCount for current filters<br/>itemCount]
F1_14{parsedCursor exists?}
F1_15[Add cursor window condition<br/>createdAt/id &lt; or &gt; cursor<br/>depending on order]
F1_16[Execute query getRawMany<br/>posts array]
F1_17[Map posts<br/>addSignedUrlsToPost for each<br/>build postsWithFiles]
F1_18[createCursorMeta cursorOptionsDto,<br/>postsWithFiles,itemCount]
F1_19[Return CursorDto<br/>items = postsWithFiles<br/>meta = cursorMeta]

F1_0 --> F1_1 --> F1_2 --> F1_3 --> F1_4 --> F1_5 --> F1_6
F1_6 -- yes --> F1_7 --> F1_8
F1_6 -- no --> F1_8

F1_8 -- no --> F1_12
F1_8 -- yes --> F1_9 --> F1_10
F1_10 -- yes --> F1_X1
F1_10 -- no --> F1_11 --> F1_12

F1_12 --> F1_13 --> F1_14
F1_14 -- yes --> F1_15 --> F1_16
F1_14 -- no --> F1_16

F1_16 --> F1_17 --> F1_18 --> F1_19
end

%% -------- F2: getBlockedUserIds helper --------
subgraph F2[getBlockedUserIds]
direction TB
F2_0[FeedService.getBlockedUserId userId]
F2_1[UserBlockRepository.find<br/>where user.id = userId<br/>select blockedUser<br/>relations: blockedUser]
F2_2[UserBlockRepository.find<br/>where blockedUser.id = userId<br/>select user<br/>relations: user]
F2_3[Collect ids from<br/>blockedByMe.blockedUser.id<br/>and blockedMe.user.id]
F2_4[Build Set of unique ids]
F2_5[Return Array&lt;string&gt;<br/>blockedUserIds]

F2_0 --> F2_1 --> F2_2 --> F2_3 --> F2_4 --> F2_5
end

%% -------- F3: getSubscriptionIds helper --------
subgraph F3[getSubscriptionIds]
direction TB
F3_0[FeedService.getSubscriptionIds userId]
F3_1[SubscriptionRepository.find<br/>where user.id = userId<br/>select subscribedUser<br/>relations: subscribedUser]
F3_2[Map subscriptions to<br/>subscribedUser.id]
F3_3[Filter out null ids]
F3_4[Return Array&lt;string&gt;<br/>subscriptionIds]

F3_0 --> F3_1 --> F3_2 --> F3_3 --> F3_4
end
end
